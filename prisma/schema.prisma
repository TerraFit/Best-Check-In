model BookingFoodRestrictions {
  id              String   @id @default(cuid())
  booking_id      String   @unique
  booking         Booking  @relation(fields: [booking_id], references: [id], onDelete: CASCADE)
  
  vegetarian      Boolean  @default(false)
  vegan           Boolean  @default(false)
  pescatarian     Boolean  @default(false)
  halal           Boolean  @default(false)
  kosher          Boolean  @default(false)
  gluten_free     Boolean  @default(false)
  lactose_free    Boolean  @default(false)
  nut_allergy     Boolean  @default(false)
  seafood_allergy Boolean  @default(false)
  diabetic        Boolean  @default(false)
  no_pork         Boolean  @default(false)
  other           Boolean  @default(false)
  other_text      String?  @db.Text
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  @@map("booking_food_restrictions")
}
